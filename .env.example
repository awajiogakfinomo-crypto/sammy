# Stock Footage Finder - Environment Variables
# For Netlify deployment, add these in Netlify Dashboard > Site Configuration > Environment Variables
# For local development with netlify dev, copy this file to .env and fill in your API keys

# Server port (for local server development only)
PORT=3001

# Pexels API (https://www.pexels.com/api/)
# Get your API key from https://www.pexels.com/api/new/
PEXELS_API_KEY=your_pexels_api_key_here

# Pixabay API (https://pixabay.com/api/docs/)
# Get your API key from https://pixabay.com/accounts/register/
PIXABAY_API_KEY=your_pixabay_api_key_here

# Unsplash API (https://unsplash.com/developers)
# Get your access key from https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here