{
  "name": "stock-footage-finder",
  "version": "1.0.0",
  "description": "Find real stock footage based on script content",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build:client && npm run build:functions",
    "build:client": "npm run build --workspace=client",
    "build:functions": "npm run build --prefix netlify/functions",
    "build:server": "npm run build --workspace=server",
    "start": "npm run start --workspace=server",
    "install:all": "npm install && npm install --workspace=client && npm install --workspace=server && npm install --prefix netlify/functions",
    "netlify:dev": "netlify dev",
    "netlify:build": "npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "netlify-cli": "^17.0.0"
  },
  "workspaces": [
    "client",
    "server"
  ]
}